# Root .env — consumed by docker-compose.yml / docker-compose.prod.yml.
# Copy to .env, fill in real values, and NEVER commit the real file
# (already covered by .gitignore). On the EC2 host: chmod 600 .env.
#
# Locally (docker-compose.yml): per-app secrets (JWT, SMTP, AWS S3, etc.) live
# separately in apps/server/.env — see its own .env.example file.
#
# In production (docker-compose.prod.yml): the server service loads
# THIS SAME root .env via `env_file`, so on the EC2 host this one file must
# also contain everything listed in apps/server/.env.example (JWT_SECRET,
# ENCRYPTION_KEY, SMTP_*, AWS_*, ALLOWED_ORIGINS, etc.) in addition to the
# infra vars below — one file to manage on the host instead of several.
#
# See docs/DEPLOYMENT.md for how these are meant to be supplied per environment
# (local file here, GitHub Environment secrets in CI/CD, and options for a
# managed secret store on AWS).

# ---- MongoDB (Atlas in production, local "mongo" service in dev) ----
MONGO_URI=mongodb://mongo:27017/filtersdk

# ---- Postgres for LiteLLM's own metadata (local "postgres" service in dev;
#      a managed hosted Postgres such as Neon in production) ----
POSTGRES_USER=llm_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=litellm_db
# In production, set DATABASE_URL directly to the managed Postgres connection string
# instead of the POSTGRES_* vars above:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ---- LiteLLM ----
LITELLM_MASTER_KEY=change-me
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Production-only: where docker-compose.prod.yml pulls images from ----
IMAGE_REGISTRY=ghcr.io/safeai613/safeai-613
IMAGE_TAG=latest
