# --- SafeAI-613 server API (this agent's only integration point - no DB access) ---
SAFEAI_API_BASE_URL=http://localhost:5000/api
SAFEAI_AGENT_API_TOKEN=REPLACE_WITH_SERVICE_TOKEN

# --- LLM provider used for classify/draft/guardrails nodes (Gemini - project's only LLM provider) ---
GEMINI_API_KEY=REPLACE_WITH_KEY
LLM_MODEL=gemini-1.5-pro

# --- LangSmith tracing / monitoring ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=REPLACE_WITH_LANGSMITH_KEY
LANGCHAIN_PROJECT=safeai-inquiry-agent
