server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Internal container healthcheck only (see Dockerfile HEALTHCHECK) — never
    # routed to from the outside, so it stays unprefixed regardless of
    # VITE_BASE_PATH.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # The base path below is substituted at build time from VITE_BASE_PATH
    # (see Dockerfile) — "/" for local dev, "/console/" when the app is
    # deployed under a sub-path behind an existing host on the domain (e.g.
    # shared with another product at "/").
    location ${VITE_BASE_PATH}api/ {
        proxy_pass http://server:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ${VITE_BASE_PATH} {
        try_files $uri $uri/ ${VITE_BASE_PATH}index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
}
