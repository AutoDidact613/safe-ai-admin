PORT=3001
OPENAI_API_KEY=sk-???
MONGO_URI=
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LLM_AS_A_JUDGE_MODEL=gpt-5.4-nano

# create a random key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Static bearer secret shared by trusted agent subprocesses (currently tender-spec-agent,
# see apps/agents/tender-spec-agent/README.md's "אימות (Auth)" section) - lets them call
# the agent-facing tender-board routes (GET .../agent-context, POST .../specification)
# without a human-minted, 15-minute-expiry JWT. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SERVICE_TOKEN=

# Frontend URL (for email links and OAuth redirects)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# CORS allowed origins (comma-separated)
# Development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production: ALLOWED_ORIGINS=https://safeai613.com,https://www.safeai613.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Email Configuration (for production)
NODE_ENV=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=SafeAI <noreply@safeai.com>

LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=master_key

# --- db-backup הסבר: משתנים אלו משמשים לגיבוי מסד הנתונים ל-AWS S3. יש למלא אותם רק אם רוצים להשתמש בפיצ'ר זה. יש להחליף את הערכים בערכים המתאימים לחשבון ה-AWS שלך ולשם הבאקט שבו תרצה לאחסן את הגיבויים. אם לא מתכוונים להשתמש בגיבוי ל-S3, ניתן להשאיר את השורות האלה כמות שהן (עם הערכים המלאים).
# AWS_ACCESS_KEY_ID=הקי_שלך
# AWS_SECRET_ACCESS_KEY=הסוד_שלך
# AWS_S3_BUCKET_NAME=שם_הבאקט_שלך

# --- forum-uploads הסבר: משתנים אלו משמשים להעלאת קבצים מצורפים (תמונות/מסמכים) לפוסטים ותגובות בפורום, דרך S3 presigned URLs (server/src/controllers/uploadController.ts). נדרשים כדי שפיצ'ר הפורום יעבוד.
AWS_ACCESS_KEY_ID=הקי_שלך
AWS_SECRET_ACCESS_KEY=הסוד_שלך
AWS_REGION=us-east-1
AWS_BUCKET_NAME=שם_הבאקט_שלך

# --- forum-auto-post הסבר: מזהה המשתמש (User._id) שבשמו יתפרסמו פוסטים אוטומטיים
# ע"י הבוט היומי (server/src/services/autoPostService.ts) כשאין פעילות אורגנית בפורום.
# יש ליצור מראש משתמש ייעודי לבוט ולהעתיק את ה-_id שלו לכאן.
BOT_USER_ID=

# --- payme-wallet הסבר: משתנים אלו משמשים לטעינת ארנק ארגון דרך PayMe (server/src/services/paymeService.ts).
# מבוסס על התיעוד הרשמי: https://docs.payme.io/docs/payments
# PAYME_ENV קובע אם לפנות ל-sandbox (sandbox.payme.io) או ל-production (live.payme.io) של PayMe.
PAYME_ENV=sandbox
# ה-seller_payme_id הפרטי שלך במערכת PayMe (מחרוזת "MPL..."). אין API key נפרד -
# זהו המזהה היחיד שנשלח בכל בקשה. תמצאי אותו בפורטל PayMe שלך תחת "אינטגרציה".
PAYME_SELLER_ID=
# מקור הלקוח (client origin) בלבד - ל-generate-sale יש כתובת redirect יחידה
# (sale_return_url), לא success/fail נפרדים. הנתיב המדויק ופרמטר requestId
# נבנים לפי בקשה ב-paymeClient.ts.
PAYME_SUCCESS_URL=http://localhost:5173
# sale_callback_url - PayMe שולח לכתובת הזו POST מסוג x-www-form-urlencoded
# (ה"Sale Callback"/IPN) כשהעסקה מסתיימת. לא ניתן להזין כאן כתובת localhost -
# לבדיקות מקומיות צריך טאנל חוץ (ngrok וכו').
PAYME_NOTIFY_URL=http://localhost:3001/organizations/:id/wallet/payme/webhook
# הערה: אימות חתימת ה-webhook (payme_signature) עדיין לא ממומש - הנוסחה לא
# מתועדת פומבית, פנייה נשלחה ל-support@payme.io. עד לתשובה, כל webhook נדחה
# כברירת מחדל (ראו verifyWebhookSignature ב-paymeService.ts).
