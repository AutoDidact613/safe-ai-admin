# ==========================================
# 🤖 Log Analysis Agent - Configuration Template
# ==========================================

# MongoDB Connection String (Read-Only user)
LOGS_MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/?appName=Cluster0

# Database and Collection Names
LOGS_DATABASE_NAME=your_database_name
LOGS_COLLECTION_NAME=applicationlogs

# בחירת ספק המודל: openai (ברירת מחדל), openrouter, או gemini
LLM_PROVIDER=openai

# OpenAI Configuration (נדרש כאשר LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter Configuration (נדרש כאשר LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Gemini Configuration (נדרש כאשר LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# שם המודל המשמש כברירת מחדל לכל ה-nodes, אלא אם הוגדר override ספציפי (למשל EVALUATOR_MODEL_NAME).
# הפורמט תלוי בספק שנבחר למעלה: "gpt-4o" עבור openai, "anthropic/claude-3.5-sonnet" (vendor/model) עבור openrouter,
# "gemini-2.5-flash" עבור gemini.
DEFAULT_MODEL=gpt-4o
# הגדרות מודל הבדיקה עבור Sub-task 4
EVALUATOR_MODEL_NAME=gpt-4o
# מודל שמתרגם בקשה חופשית ב-CLI לפילטר סינון (אופציונלי, נופל ל-DEFAULT_MODEL אם לא מוגדר)
INTERPRETER_MODEL_NAME=gpt-4o

# Security & Execution Limits
SANDBOX_EXECUTION_TIMEOUT=10
MAX_LOG_ENTRIES_PER_QUERY=1000

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=forum-log-analysis-agent