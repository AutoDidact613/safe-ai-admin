# הגדרות למודל א'
LLM_A_PROVIDER=openrouter
LLM_A_MODEL=anthropic/claude-3.5-sonnet
LLM_A_API_KEY=your_actual_api_key_here

# הגדרות למודל ב' (ניתן להשתמש באותו מפתח אם שניהם ב-OpenRouter)
LLM_B_PROVIDER=openrouter
LLM_B_MODEL=openai/gpt-4o-mini
LLM_B_API_KEY=your_actual_api_key_here

# הגדרות ברירת מחדל לרכיב הסינון (Guardrail)
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_API_KEY=your_actual_api_key_here

# חיבור למסד הנתונים MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=safeai_db

# נתיב יחסי לתיקיית הפורום
FORUM_PATH=../../client/src/features/forum