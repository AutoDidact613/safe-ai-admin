# --- SafeAI-613 server API (this agent's only integration point - no DB access) ---
# Note: tender-board routes are mounted at the server root (no /api prefix) -
# see apps/server/src/index.ts (`app.use("/tender-board", tenderBoardRouter)`).
SAFEAI_API_BASE_URL=http://localhost:3001
SAFEAI_AGENT_API_TOKEN=REPLACE_WITH_SERVICE_TOKEN

# --- LLM provider used for tech_stack_node (Gemini - project's only LLM provider) ---
GEMINI_API_KEY=REPLACE_WITH_KEY
# "gemini-1.5-pro" has been retired by Google (404 NOT_FOUND on generateContent) -
# use the "-latest" alias instead so this doesn't break again as models rotate.
LLM_MODEL=gemini-flash-latest

# --- Google Custom Search API, used for research_node (open-source projects + reading sources) ---
# Search engine created at https://programmablesearchengine.google.com/. "Search the entire
# web" was not available on this Google account, so the search engine itself is scoped to a
# fixed list of sites (github.com, gitlab.com, stackoverflow.com, dev.to, medium.com,
# freecodecamp.org) instead - see nodes.py's _OPEN_SOURCE_SITES / _READING_SITES.
GOOGLE_SEARCH_API_KEY=REPLACE_WITH_KEY
GOOGLE_SEARCH_ENGINE_ID=REPLACE_WITH_SEARCH_ENGINE_ID

# --- LangSmith tracing / monitoring (optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=REPLACE_WITH_LANGSMITH_KEY
LANGCHAIN_PROJECT=safeai-tender-spec-agent

# ============================================================================
# ⚠️⚠️⚠️  INSECURE - LOCAL DEV ONLY - DELETE THIS LINE BEFORE PRODUCTION  ⚠️⚠️⚠️
# ============================================================================
# Uncomment ONLY if you're behind an SSL-inspecting network filter (e.g.
# Netfree) and outbound HTTPS calls fail with
# "[SSL: CERTIFICATE_VERIFY_FAILED] ... key usage extension" errors.
# This disables TLS certificate verification for EVERY HTTPS call this
# process makes - it must NEVER be set in staging/production. See config.py
# for what it does. The safer fix (trusting the filter's cert instead of
# disabling verification) is documented in this agent's README.
# DISABLE_SSL_VERIFY_INSECURE_DEV_ONLY=true
