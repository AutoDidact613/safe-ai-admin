# --- SafeAI-613 server API (this agent's only integration point - no DB access) ---
# Note: tender-board routes are mounted at the server root (no /api prefix) -
# see apps/server/src/index.ts (`app.use("/tender-board", tenderBoardRouter)`).
SAFEAI_API_BASE_URL=http://localhost:3001
SAFEAI_AGENT_API_TOKEN=REPLACE_WITH_SERVICE_TOKEN

# --- LLM provider used for tech_stack_node (Gemini - project's only LLM provider) ---
GEMINI_API_KEY=REPLACE_WITH_KEY
LLM_MODEL=gemini-1.5-pro

# --- Tavily Search API, used for research_node (open-source projects + reading sources) ---
TAVILY_API_KEY=REPLACE_WITH_TAVILY_KEY

# --- LangSmith tracing / monitoring (optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=REPLACE_WITH_LANGSMITH_KEY
LANGCHAIN_PROJECT=safeai-tender-spec-agent
