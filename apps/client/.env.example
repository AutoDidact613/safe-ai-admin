VITE_API_URL=http://localhost:3001
VITE_BASE_PATH=/
ROUTER_BASE=

# הגבלות גודל קובץ מצורף בפורום, לפי סוג - לבדיקה מיידית בצד הלקוח בלבד
# (לא אכיפה אמיתית - זו נעשית בשרת). חייבים להישאר זהים לערכים
# המקבילים ב-apps/server/.env (MAX_UPLOAD_SIZE_IMAGE_MB וכו') - עדכון כאן
# בלי לעדכן גם בשרת ייצור חוויית משתמש לא עקבית (שגיאה בצד אחד, לא בשני)
VITE_MAX_UPLOAD_SIZE_IMAGE_MB=20
VITE_MAX_UPLOAD_SIZE_DOCUMENT_MB=50
VITE_MAX_UPLOAD_SIZE_VIDEO_GB=2.5

# Production values:
# VITE_API_URL=/console/api
# VITE_BASE_PATH=/console/
# ROUTER_BASE=/console/
